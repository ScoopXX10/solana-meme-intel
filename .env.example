# -----------------------------
# Supabase Configuration
# -----------------------------
SUPABASE_URL=your-supabase-url-here
SUPABASE_KEY=your-supabase-service-role-key-here

# -----------------------------
# Helius Configuration
# -----------------------------
# RPC endpoint (NOT the API key)
# Example: https://mainnet.helius-rpc.com/?api-key=XXXX
HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=your-rpc-key-here

# REST API Key for token metadata
# Example: 60ff47cb-999a-4611-be4d-cb3dfc3bc441
HELIUS_API_KEY=your-helius-api-key-here

# -----------------------------
# Birdeye Configuration
# -----------------------------
# Get your API key from https://birdeye.so/
BIRDEYE_API_KEY=your-birdeye-api-key-here

# -----------------------------
# Telegram Bot Configuration
# -----------------------------
# Create a bot via @BotFather on Telegram
# See docs/TELEGRAM_SETUP.md for instructions
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# -----------------------------
# Scheduler Configuration
# -----------------------------
# Interval (minutes) for refreshing token metadata & prices
TOKEN_REFRESH_INTERVAL=30

# Interval (minutes) for discovering new tokens
NEW_TOKEN_DISCOVER_INTERVAL=10
